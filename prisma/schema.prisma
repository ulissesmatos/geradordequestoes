generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum QuestionAnswer {
  CERTO
  ERRADO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SourceType {
  AI
  MANUAL
}

enum AiProvider {
  OPENAI
  CLAUDE
  OPENROUTER
}

enum EmailProvider {
  BREVO
  RESEND
}

enum AiChatPresetUsageLevel {
  NENHUM
  POUCO
  MEDIO
  ALTO
}

enum AiUsageEventType {
  CHAT_RESPONSE
  QUESTION_GENERATION
}

enum AiUsageEventStatus {
  SUCCESS
  ERROR
}

enum QuestionFormat {
  CERTO_ERRADO
  MULTIPLA_ESCOLHA
}

enum QuestionSetMode {
  ESTUDO
  SIMULADO
  REVISAO
}

enum QuestionSetStatus {
  READY
  ARCHIVED
}

enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum StudyMaterialStatus {
  DRAFT
  READY
  ARCHIVED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  MANUAL
}

enum PaymentCheckoutStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELED
  ERROR
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELED
  ERROR
}

enum SubscriptionEventType {
  CREATED
  UPDATED
  PAID
  PAST_DUE
  CANCELED
  EXPIRED
  MANUAL
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String?
  emailVerified     DateTime?
  image             String?
  cpf               String?
  birthDate         DateTime?
  phone             String?
  role              Role               @default(USER)
  isBlocked         Boolean            @default(false)
  stripeCustomerId  String?
  trialGenerationsUsed Int             @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdQuestions  Question[]         @relation("CreatedQuestions")
  reviewedQuestions Question[]         @relation("ReviewedQuestions")
  attempts          QuestionAttempt[]
  favorites         FavoriteQuestion[]
  aiLogs            AiGenerationLog[]
  aiUsageEvents     AiUsageEvent[]
  questionSets      QuestionSet[]
  aiChatSessions    AiChatSession[]
  subscriptions     UserSubscription[]
  studyMaterials     StudyMaterial[]
  checkoutSessions   PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  subscriptionEvents SubscriptionEvent[]
  verificationCodes  EmailVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  questionFeedbacks  QuestionFeedback[]
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AiProviderSetting {
  id                   String                 @id @default("default")
  provider             AiProvider             @default(OPENAI)
  apiKey               String?
  model                String                 @default("gpt-4.1-mini")
  baseUrl              String?
  siteUrl              String?
  appName              String?
  chatPresetUsageLevel AiChatPresetUsageLevel @default(MEDIO)
  webSearchEnabled     Boolean                @default(false)
  webSearchApiKey      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Subject {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  topics       Topic[]
  questions    Question[]
  aiLogs       AiGenerationLog[]
  questionSets QuestionSet[]
  studyMaterials StudyMaterial[]
}

model Topic {
  id           String            @id @default(cuid())
  subjectId    String
  name         String
  slug         String
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions    Question[]
  aiLogs       AiGenerationLog[]
  questionSets QuestionSet[]
  studyMaterials StudyMaterial[]

  @@unique([subjectId, slug])
}

model Question {
  id            String             @id @default(cuid())
  subjectId     String
  topicId       String
  questionSetId String?
  orderInSet    Int?
  format        QuestionFormat     @default(CERTO_ERRADO)
  statement     String
  answer        QuestionAnswer?
  explanation   String
  difficulty    Difficulty
  status        QuestionStatus     @default(PENDING_REVIEW)
  sourceType    SourceType         @default(MANUAL)
  aiModel       String?
  createdById   String?
  reviewedById  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionSet   QuestionSet?       @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  createdBy     User?              @relation("CreatedQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?              @relation("ReviewedQuestions", fields: [reviewedById], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  attempts      QuestionAttempt[]
  favorites     FavoriteQuestion[]
  feedbacks     QuestionFeedback[]
}

model QuestionOption {
  id         String            @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean           @default(false)
  order      Int
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts   QuestionAttempt[]

  @@unique([questionId, label])
}

model QuestionAttempt {
  id               String          @id @default(cuid())
  userId           String
  questionId       String
  userAnswer       QuestionAnswer?
  selectedOptionId String?
  userAnswerText   String?
  isCorrect        Boolean
  timeSpentSeconds Int
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
}

model FavoriteQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model AiGenerationLog {
  id           String     @id @default(cuid())
  adminId      String
  subjectId    String
  topicId      String
  difficulty   Difficulty
  quantity     Int
  model        String
  prompt       String
  status       String
  errorMessage String?
  createdAt    DateTime   @default(now())
  admin        User       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model AiUsageEvent {
  id           String             @id @default(cuid())
  userId       String
  type         AiUsageEventType
  status       AiUsageEventStatus @default(SUCCESS)
  model        String?
  prompt       String?
  errorMessage String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuestionSet {
  id                String            @id @default(cuid())
  userId            String
  subjectId         String
  topicId           String
  chatSessionId     String?
  title             String
  prompt            String
  mode              QuestionSetMode   @default(ESTUDO)
  format            QuestionFormat    @default(CERTO_ERRADO)
  alternativesCount Int?
  difficulty        Difficulty
  quantity          Int
  aiModel           String?
  status            QuestionSetStatus @default(READY)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic             Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chatSession       AiChatSession?    @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  questions         Question[]
  messages          AiChatMessage[]
}

model AiChatSession {
  id              String          @id @default(cuid())
  userId          String
  title           String
  summary         String?
  summarizedCount Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiChatMessage[]
  questionSets    QuestionSet[]
}

model AiChatMessage {
  id              String                    @id @default(cuid())
  sessionId       String
  questionSetId   String?
  studyMaterialId String?
  role            AiChatRole
  content         String
  metadata        Json?
  createdAt       DateTime                  @default(now())
  session         AiChatSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionSet     QuestionSet?              @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  studyMaterial   StudyMaterial?            @relation(fields: [studyMaterialId], references: [id], onDelete: SetNull)
  attachments     AiChatMessageAttachment[]
}

enum AttachmentKind {
  IMAGE
  PDF
}

model AiChatMessageAttachment {
  id            String         @id @default(cuid())
  messageId     String
  kind          AttachmentKind
  url           String
  name          String
  mimeType      String
  size          Int
  extractedText String?
  createdAt     DateTime       @default(now())
  message       AiChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  entity     String
  entityId   String?
  summary    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model StudyMaterial {
  id          String              @id @default(cuid())
  userId      String
  subjectId   String?
  topicId     String?
  title       String
  prompt      String
  content     String
  aiModel     String?
  status      StudyMaterialStatus @default(READY)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic       Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages    AiChatMessage[]
}

model SubscriptionPlan {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  description         String?
  marketingSubtitle   String?
  ctaText             String             @default("Criar conta")
  displayOrder        Int                @default(0)
  isHighlighted       Boolean            @default(false)
  features            String[]           @default([])
  stripePriceId       String?
  mercadoPagoReference String?
  priceCents          Int
  aiGenerationsPerDay Int
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  subscriptions       UserSubscription[]
  checkoutSessions    PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  teamAccounts        TeamAccount[]
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  couponId  String?
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  reminderSentAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon    Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  events    SubscriptionEvent[]
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  type          CouponType
  value         Int
  maxUses       Int?
  usedCount     Int                @default(0)
  expiresAt     DateTime?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]
}

model PricingContent {
  id                  String   @id @default("default")
  headline            String   @default("Planos para estudar com IA todos os dias.")
  subheadline         String   @default("Escolha um plano ativo, crie sua conta e libere a geração de questões, simulados, revisões e materiais pelo painel.")
  paywallTitle        String   @default("Assinatura necessária")
  paywallDescription  String   @default("A geração de questões, estudos, simulados, revisão e materiais por IA ficam disponíveis para usuários com plano ativo.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AppSetting {
  id                String   @id @default("default")
  appName           String   @default("Gerador de Questões")
  logoUrl           String   @default("/brand/logo.png")
  faviconUrl        String   @default("/brand/favicon.png")
  primaryColor      String   @default("#13666a")
  accentColor       String   @default("#f6d979")
  publicUrl         String?
  adminEmails       String   @default("")
  institutionalText String   @default("Plataforma AI-first para gerar questões, simulados, revisões e materiais de estudo para concursos públicos.")
  termsUrl          String?
  privacyUrl        String?
  termsContent      String?
  privacyContent    String?
  trialGenerationsLimit Int  @default(10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum MercadoPagoCheckoutMode {
  CHECKOUT_PRO
  TRANSPARENT
}

model PaymentGatewaySetting {
  id                          String          @id @default("default")
  stripeSecretKey             String?
  stripeWebhookSecret         String?
  stripePortalEnabled         Boolean         @default(true)
  mercadoPagoAccessToken      String?
  mercadoPagoWebhookSecret    String?
  mercadoPagoPublicKey        String?
  mercadoPagoCheckoutMode     MercadoPagoCheckoutMode @default(CHECKOUT_PRO)
  testMode                    Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
}

model EmailSetting {
  id        String        @id @default("default")
  provider  EmailProvider @default(BREVO)
  apiKey    String?
  fromEmail String?
  fromName  String?
  replyTo   String?
  enabled   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactMessageKind {
  GENERAL
  TEAMS
}

model ContactMessage {
  id        String             @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  kind      ContactMessageKind @default(GENERAL)
  userId    String?
  handledAt DateTime?
  createdAt DateTime           @default(now())

  @@index([kind])
  @@index([handledAt])
}

enum TeamAccountStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum TeamSeatStatus {
  PENDING
  CLAIMED
  REVOKED
}

model TeamAccount {
  id                 String            @id @default(cuid())
  name               String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  cpfCnpj            String?
  planId             String
  seats              Int               @default(1)
  priceCents         Int               @default(0)
  status             TeamAccountStatus @default(ACTIVE)
  currentPeriodEndsAt DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  members TeamSeat[]
  charges TeamCharge[]
}

model TeamSeat {
  id            String         @id @default(cuid())
  teamAccountId String
  cpf           String?
  inviteCode    String?        @unique
  userId        String?
  claimedAt     DateTime?
  status        TeamSeatStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  teamAccount TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Cascade)

  @@index([teamAccountId])
  @@index([cpf])
  @@index([userId])
}

model TeamCharge {
  id              String                   @id @default(cuid())
  teamAccountId   String
  amountCents     Int
  status          PaymentTransactionStatus @default(PENDING)
  externalId      String?
  pixQrCode       String?
  pixQrCodeBase64 String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  teamAccount TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Cascade)

  @@index([teamAccountId])
}

enum FeedbackType {
  GABARITO_ERRADO
  ENUNCIADO_CONFUSO
  DESATUALIZADA
  OUTRO
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model QuestionFeedback {
  id         String         @id @default(cuid())
  userId     String
  questionId String
  type       FeedbackType   @default(OUTRO)
  message    String?
  status     FeedbackStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([status])
  @@index([questionId])
}

enum ReferenceKind {
  PROVA
  GABARITO
  LEI
  RESUMO
  OUTRO
}

model ReferenceDocument {
  id          String           @id @default(cuid())
  title       String
  source      String?
  kind        ReferenceKind    @default(OUTRO)
  subjectId   String?
  topicId     String?
  createdById String?
  createdAt   DateTime         @default(now())
  chunks      ReferenceChunk[]
}

model ReferenceChunk {
  id         String            @id @default(cuid())
  documentId String
  subjectId  String?
  topicId    String?
  content    String
  ordinal    Int
  createdAt  DateTime          @default(now())
  document   ReferenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([subjectId])
  @@index([topicId])
}

model PaymentCheckoutSession {
  id                 String                @id @default(cuid())
  userId             String
  planId             String
  provider           PaymentProvider
  status             PaymentCheckoutStatus @default(PENDING)
  externalId         String?
  checkoutUrl        String?
  amountCents        Int
  currency           String                @default("BRL")
  metadata           Json?
  expiresAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  transactions       PaymentTransaction[]

  @@index([provider, externalId])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  userId            String
  planId            String
  checkoutSessionId String?
  provider          PaymentProvider
  status            PaymentTransactionStatus @default(PENDING)
  externalId        String?
  amountCents       Int
  currency          String                   @default("BRL")
  paidAt            DateTime?
  rawPayload        Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  checkoutSession   PaymentCheckoutSession?  @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  userId         String
  subscriptionId String?
  provider       PaymentProvider
  type           SubscriptionEventType
  externalId     String?
  payload        Json?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   UserSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}
