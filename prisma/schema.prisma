generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum QuestionAnswer {
  CERTO
  ERRADO
}

enum Difficulty {
  FACIL
  MEDIO
  DIFICIL
}

enum QuestionStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SourceType {
  AI
  MANUAL
}

enum AiProvider {
  OPENAI
  CLAUDE
  OPENROUTER
}

enum EmailProvider {
  BREVO
  RESEND
}

enum AiChatPresetUsageLevel {
  NENHUM
  POUCO
  MEDIO
  ALTO
}

enum AiUsageEventType {
  CHAT_RESPONSE
  QUESTION_GENERATION
}

enum AiUsageEventStatus {
  SUCCESS
  ERROR
}

enum QuestionFormat {
  CERTO_ERRADO
  MULTIPLA_ESCOLHA
}

enum QuestionSetMode {
  ESTUDO
  SIMULADO
  REVISAO
}

enum QuestionSetStatus {
  READY
  ARCHIVED
}

enum AiChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum StudyMaterialStatus {
  DRAFT
  READY
  ARCHIVED
}

enum PaymentProvider {
  STRIPE
  MERCADO_PAGO
  MANUAL
}

enum PaymentCheckoutStatus {
  PENDING
  COMPLETED
  EXPIRED
  CANCELED
  ERROR
}

enum PaymentTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELED
  ERROR
}

enum SubscriptionEventType {
  CREATED
  UPDATED
  PAID
  PAST_DUE
  CANCELED
  EXPIRED
  MANUAL
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String?
  emailVerified     DateTime?
  image             String?
  cpf               String?
  birthDate         DateTime?
  phone             String?
  role              Role               @default(USER)
  isBlocked         Boolean            @default(false)
  stripeCustomerId  String?
  trialGenerationsUsed Int             @default(0)
  // Prova de consentimento: quando o usuário aceitou os Termos e a Política de Privacidade.
  // Nulo em contas criadas antes deste registro existir.
  termsAcceptedAt   DateTime?
  preferredStates   String[]           @default([])
  // Revisão espaçada: opt-out do lembrete diário e idempotência do cron de envio.
  reviewReminderOptOut Boolean         @default(false)
  reviewReminderSentAt DateTime?
  // Constância: meta diária de questões (null = sem meta) e resumo semanal por e-mail.
  dailyQuestionGoal    Int?
  weeklySummaryOptOut  Boolean         @default(false)
  weeklySummarySentAt  DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  createdQuestions  Question[]         @relation("CreatedQuestions")
  reviewedQuestions Question[]         @relation("ReviewedQuestions")
  attempts          QuestionAttempt[]
  favorites         FavoriteQuestion[]
  aiLogs            AiGenerationLog[]
  aiUsageEvents     AiUsageEvent[]
  trialUsageEvents  TrialUsageEvent[]
  usageLedger       UsageLedger[]
  questionSets      QuestionSet[]
  aiChatSessions    AiChatSession[]
  subscriptions     UserSubscription[]
  studyMaterials     StudyMaterial[]
  checkoutSessions   PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  subscriptionEvents SubscriptionEvent[]
  verificationCodes  EmailVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  questionFeedbacks  QuestionFeedback[]
  mockExamSessions   MockExamSession[]
  createdMockExams   MockExam[]         @relation("CreatedMockExams")
  reviewStates       QuestionReviewState[]
  affiliateProfile   AffiliateProfile?
  referredBy         AffiliateReferral?
  chatShares         ChatShare[]
  questionSetShares  QuestionSetShare[]
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AiProviderSetting {
  id                   String                 @id @default("default")
  provider             AiProvider             @default(OPENAI)
  apiKey               String?
  model                String                 @default("gpt-4.1-mini")
  baseUrl              String?
  siteUrl              String?
  appName              String?
  chatPresetUsageLevel AiChatPresetUsageLevel @default(MEDIO)
  webSearchEnabled     Boolean                @default(false)
  webSearchApiKey      String?
  extractionModel      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
}

model Subject {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  topics       Topic[]
  questions    Question[]
  aiLogs       AiGenerationLog[]
  questionSets QuestionSet[]
  studyMaterials StudyMaterial[]
}

model Topic {
  id           String            @id @default(cuid())
  subjectId    String
  name         String
  slug         String
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subject      Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions    Question[]
  aiLogs       AiGenerationLog[]
  questionSets QuestionSet[]
  studyMaterials StudyMaterial[]

  @@unique([subjectId, slug])
}

model Question {
  id            String             @id @default(cuid())
  subjectId     String
  topicId       String
  questionSetId String?
  orderInSet    Int?
  format        QuestionFormat     @default(CERTO_ERRADO)
  statement     String
  // Texto de apoio compartilhado (situação hipotética, trecho de lei, texto informativo) — usado em
  // blocos no estilo Cebraspe onde várias questões julgam o mesmo texto. Repetido por questão de
  // propósito (cada uma fica autossuficiente, sem depender de outras do mesmo bloco).
  supportText   String?
  answer        QuestionAnswer?
  explanation   String
  difficulty    Difficulty
  status        QuestionStatus     @default(PENDING_REVIEW)
  sourceType    SourceType         @default(MANUAL)
  aiModel       String?
  createdById   String?
  reviewedById  String?
  // Questão real de referência da qual esta foi gerada como variação próxima (modo "baseado em provas reais").
  sourceReferenceQuestionId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questionSet   QuestionSet?       @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  createdBy     User?              @relation("CreatedQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy    User?              @relation("ReviewedQuestions", fields: [reviewedById], references: [id], onDelete: SetNull)
  sourceReferenceQuestion ReferenceQuestion? @relation(fields: [sourceReferenceQuestionId], references: [id], onDelete: SetNull)
  options       QuestionOption[]
  attempts      QuestionAttempt[]
  favorites     FavoriteQuestion[]
  feedbacks     QuestionFeedback[]
  mockExamAnswers MockExamAnswer[]
  reviewStates  QuestionReviewState[]

  @@index([sourceReferenceQuestionId])
  @@index([status, subjectId, topicId])
  @@index([status, createdAt])
}

model QuestionOption {
  id         String            @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean           @default(false)
  order      Int
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts   QuestionAttempt[]

  @@unique([questionId, label])
}

model QuestionAttempt {
  id                String           @id @default(cuid())
  userId            String
  questionId        String
  userAnswer        QuestionAnswer?
  selectedOptionId  String?
  userAnswerText    String?
  isCorrect         Boolean
  timeSpentSeconds  Int
  mockExamSessionId String?
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question          Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption    QuestionOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  mockExamSession   MockExamSession? @relation(fields: [mockExamSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([questionId])
}

// Revisão espaçada: uma linha por usuário+questão com a próxima data de revisão.
// Intervalos determinísticos (sem IA) — ver src/lib/review.ts.
model QuestionReviewState {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  correctStreak Int      @default(0)
  lapses        Int      @default(0)
  lastIsCorrect Boolean
  lastAttemptAt DateTime
  dueAt         DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, dueAt])
}

model FavoriteQuestion {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
}

model AiGenerationLog {
  id           String     @id @default(cuid())
  adminId      String
  subjectId    String
  topicId      String
  difficulty   Difficulty
  quantity     Int
  model        String
  prompt       String
  status       String
  errorMessage String?
  createdAt    DateTime   @default(now())
  admin        User       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

/**
 * Log BRUTO de chamadas de IA: uma linha por chamada ao provedor. Alimenta /admin/logs-ia e o
 * limite DIÁRIO dos planos pagos. Não serve para medir a cota do trial — uma única mensagem do
 * usuário pode gerar várias linhas aqui (resposta do chat + geração de questões, por exemplo).
 * A cota do trial é contada em TrialUsageEvent.
 */
model AiUsageEvent {
  id           String             @id @default(cuid())
  userId       String
  type         AiUsageEventType
  status       AiUsageEventStatus @default(SUCCESS)
  model        String?
  prompt       String?
  errorMessage String?
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TrialUsageKind {
  CHAT_MESSAGE
  QUESTION_GENERATION
  MATERIAL_EXPAND
}

/**
 * Livro-caixa da cota do TRIAL: uma linha por AÇÃO do usuário, não por chamada de IA. Uma
 * mensagem no chat que dispara tool de geração + várias iterações de tool consome 1 linha aqui.
 * Vive separado de AiUsageEvent de propósito: o limite diário dos planos pagos continua lendo
 * AiUsageEvent sem nenhuma alteração, e código compartilhado (generateAndSaveQuestionSet, que
 * roda em 4 contextos diferentes) não precisa saber se aquela chamada "conta" ou não.
 */
model TrialUsageEvent {
  id        String         @id @default(cuid())
  userId    String
  kind      TrialUsageKind
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * Medidores cobrados. Deliberadamente DOIS, e não um saldo único de "créditos":
 *
 * - Uma moeda única obrigaria pesar chat contra geração ("1 questão = 1, 1 mensagem = 3"),
 *   o que canibaliza — quem conversa muito perde capacidade de gerar — e não vende:
 *   "você usou 143 de 600 créditos" não significa nada para o aluno.
 * - Separados, cada um vira um número honesto no card: "N questões/mês" e "M mensagens/dia".
 *
 * O ganho decisivo, porém, é técnico. Com um medidor só, cobrar dentro do funil de geração
 * E no ponto de entrada do chat cobraria duas vezes a mesma mensagem — foi exatamente o bug
 * que existia com AiUsageEvent. Com medidores distintos, a mensagem debita CHAT no entry
 * point e a geração debita QUESTIONS dentro de generateAndSaveQuestionSet, que é o único
 * lugar por onde TODOS os caminhos de geração passam.
 *
 * Material não tem medidor próprio: gerar/aprofundar material é uma ação de IA como uma
 * mensagem, então debita CHAT. O `kind` preserva a distinção para auditoria, sem criar um
 * terceiro número para vender.
 */
enum UsageMeter {
  QUESTIONS
  CHAT
}

enum UsageKind {
  CHAT_MESSAGE
  QUESTION_GENERATION
  MATERIAL_GENERATION
  MATERIAL_EXPAND
}

/**
 * Livro-caixa único de consumo — trial e assinante no mesmo lugar (TrialUsageEvent cobria
 * só o trial; quem pagava não tinha registro nenhum de consumo por ação).
 *
 * Estorno é SOFT (`refundedAt`), não delete: a linha nunca some, então "cobrei e devolvi"
 * continua auditável quando um cliente reclama, e chamar o estorno duas vezes é inofensivo
 * por construção — antes era inofensivo só por acidente.
 */
model UsageLedger {
  id             String     @id @default(cuid())
  userId         String
  meter          UsageMeter
  kind           UsageKind
  /** Unidades cobradas. Em QUESTIONS é o número de questões; em CHAT é sempre 1. */
  costUnits      Int        @default(1)
  /** null = consumo do trial. Preenchido permite auditar por ciclo e por plano. */
  subscriptionId String?
  planId         String?
  refundedAt     DateTime?
  createdAt      DateTime   @default(now())
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, meter, createdAt])
}

model QuestionSet {
  id                String            @id @default(cuid())
  userId            String
  subjectId         String
  topicId           String
  chatSessionId     String?
  title             String
  prompt            String
  mode              QuestionSetMode   @default(ESTUDO)
  format            QuestionFormat    @default(CERTO_ERRADO)
  alternativesCount Int?
  difficulty        Difficulty
  quantity          Int
  aiModel           String?
  status            QuestionSetStatus @default(READY)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic             Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chatSession       AiChatSession?    @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  questions         Question[]
  messages          AiChatMessage[]
  mockExam          MockExam?
  share             QuestionSetShare?
}

/**
 * Link público de um bloco de questões (estilo "share" do ChatGPT), com acesso em camadas
 * resolvido em answerQuestionAction: visitante anônimo só vê a 1ª questão (sem gabarito,
 * omitido já na consulta); logado sem plano responde tudo com CTA de assinar; assinante
 * responde sem fricção. `id` é o próprio token da URL (/q/<id>).
 */
model QuestionSetShare {
  id            String      @id @default(cuid())
  questionSetId String      @unique
  userId        String
  createdAt     DateTime    @default(now())
  revokedAt     DateTime?
  questionSet   QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum MockExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model MockExam {
  id              String         @id @default(cuid())
  title           String
  description     String?
  questionSetId   String         @unique
  teamAccountId   String?
  durationMinutes Int
  opensAt         DateTime?
  closesAt        DateTime?
  status          MockExamStatus @default(DRAFT)
  createdById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questionSet     QuestionSet    @relation(fields: [questionSetId], references: [id], onDelete: Restrict)
  teamAccount     TeamAccount?   @relation(fields: [teamAccountId], references: [id], onDelete: SetNull)
  createdBy       User?          @relation("CreatedMockExams", fields: [createdById], references: [id], onDelete: SetNull)
  sessions        MockExamSession[]

  @@index([status])
  @@index([teamAccountId])
}

model MockExamSession {
  id           String            @id @default(cuid())
  mockExamId   String
  userId       String
  startedAt    DateTime          @default(now())
  expiresAt    DateTime
  finishedAt   DateTime?
  netScore     Int?
  correctCount Int?
  wrongCount   Int?
  blankCount   Int?
  totalSeconds Int?
  createdAt    DateTime          @default(now())
  mockExam     MockExam          @relation(fields: [mockExamId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers      MockExamAnswer[]
  attempts     QuestionAttempt[]

  @@unique([mockExamId, userId])
  @@index([mockExamId, finishedAt])
}

model MockExamAnswer {
  id         String          @id @default(cuid())
  sessionId  String
  questionId String
  userAnswer QuestionAnswer?
  updatedAt  DateTime        @updatedAt
  session    MockExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
}

model AiChatSession {
  id              String          @id @default(cuid())
  userId          String
  title           String
  /**
   * Quando a IA nomeou a conversa. Preenchido = não renomear mais: só o PRIMEIRO pedido dá
   * nome à sessão, senão o item pularia de nome na barra lateral a cada mensagem.
   */
  titleGeneratedAt DateTime?
  summary         String?
  summarizedCount Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        AiChatMessage[]
  questionSets    QuestionSet[]
  share           ChatShare?
}

model AiChatMessage {
  id              String                    @id @default(cuid())
  sessionId       String
  questionSetId   String?
  studyMaterialId String?
  role            AiChatRole
  content         String
  metadata        Json?
  createdAt       DateTime                  @default(now())
  session         AiChatSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionSet     QuestionSet?              @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  studyMaterial   StudyMaterial?            @relation(fields: [studyMaterialId], references: [id], onDelete: SetNull)
  attachments     AiChatMessageAttachment[]
}

enum AttachmentKind {
  IMAGE
  PDF
}

model AiChatMessageAttachment {
  id            String         @id @default(cuid())
  messageId     String
  kind          AttachmentKind
  url           String
  name          String
  mimeType      String
  size          Int
  extractedText String?
  createdAt     DateTime       @default(now())
  message       AiChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/**
 * Link público de uma conversa (estilo "share" do ChatGPT): cópia estática, congelada no
 * momento do compartilhamento — não uma sessão viva. `id` é o próprio token da URL
 * (/c/<id>), mesma entropia de cuid já usada como token não adivinhável em outros links
 * públicos do projeto (ver TeamCharge/cobrança).
 */
model ChatShare {
  id        String        @id @default(cuid())
  sessionId String        @unique
  userId    String
  /**
   * Cutoff do congelamento: só mensagens com createdAt <= este instante aparecem no link.
   * Atualizado sempre que o dono (re)compartilha, inclusive ao reativar um link revogado —
   * então reativar passa a incluir as mensagens novas desde a revogação, de propósito.
   */
  sharedUpTo DateTime
  createdAt DateTime      @default(now())
  revokedAt DateTime?
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  action     String
  entity     String
  entityId   String?
  summary    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model StudyMaterial {
  id          String              @id @default(cuid())
  userId      String
  subjectId   String?
  topicId     String?
  title       String
  prompt      String
  content     String
  aiModel     String?
  status      StudyMaterialStatus @default(READY)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic       Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages    AiChatMessage[]
}

model SubscriptionPlan {
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique
  description         String?
  marketingSubtitle   String?
  ctaText             String             @default("Criar conta")
  displayOrder        Int                @default(0)
  isHighlighted       Boolean            @default(false)
  features            String[]           @default([])
  stripePriceId       String?
  mercadoPagoReference String?
  priceCents          Int
  // DEPRECADO: contava CHAMADAS ao provedor, não questões — uma mensagem de chat e um bloco
  // de 15 questões custavam a mesma unidade. Substituído pelas cotas abaixo; mantido por um
  // release para permitir rollback enquanto o modo sombra roda.
  aiGenerationsPerDay Int
  /** Cota principal vendida: questões geradas por ciclo. null = ilimitado. */
  questionsPerMonth   Int?
  /** Rajada diária: trava anti-abuso e, de quebra, motivo para voltar amanhã. null = sem teto. */
  questionsPerDay     Int?
  /** Teto de questões em CADA bloco — o diferencial mais direto entre planos. null = sem teto. */
  maxQuestionsPerGeneration Int?
  /** Generoso de propósito: conversar é barato perto de gerar questão. null = ilimitado. */
  chatMessagesPerDay  Int?
  // DEPRECADO: migrado para capabilities.materialExpand. Mantido por um release para
  // permitir rollback; parar de ler quando o medidor novo estiver estável.
  materialExpandEnabled Boolean          @default(false)
  /**
   * Liga/desliga de features por plano. As chaves válidas e seus defaults vivem no
   * registry tipado em src/lib/capabilities.ts, não aqui — feature nova é uma linha lá,
   * sem migration. Chave desconhecida é ignorada na leitura, então remover uma capability
   * do registry não quebra planos com JSON antigo.
   *
   * Só o liga/desliga mora em JSON; limites numéricos vendidos (cota mensal, teto diário,
   * tamanho de bloco) são colunas de verdade, porque entram em relatório e ordenação.
   */
  capabilities        Json               @default("{}")
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  subscriptions       UserSubscription[]
  checkoutSessions    PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  teamAccounts        TeamAccount[]
}

model UserSubscription {
  id        String             @id @default(cuid())
  userId    String
  planId    String
  couponId  String?
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  reminderSentAt DateTime?
  /**
   * Grandfathering nominal: sobrescreve as cotas do plano para UM cliente. Mesmas chaves de
   * SubscriptionPlan (questionsPerMonth, questionsPerDay, maxQuestionsPerGeneration,
   * chatMessagesPerDay). Serve para quem já consumia acima do teto novo manter o que tinha
   * até cancelar — nenhuma mudança de plano deve reduzir acesso de assinatura vigente.
   */
  limitsOverride Json?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon    Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  events    SubscriptionEvent[]
}

model Coupon {
  id               String                   @id @default(cuid())
  code             String                   @unique
  type             CouponType
  value            Int
  maxUses          Int?
  usedCount        Int                      @default(0)
  expiresAt        DateTime?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  subscriptions    UserSubscription[]
  checkoutSessions PaymentCheckoutSession[]
}

model PricingContent {
  id                  String   @id @default("default")
  headline            String   @default("Planos para estudar com IA todos os dias.")
  subheadline         String   @default("Escolha um plano ativo, crie sua conta e libere a geração de questões, simulados, revisões e materiais pelo painel.")
  paywallTitle        String   @default("Assinatura necessária")
  paywallDescription  String   @default("A geração de questões, estudos, simulados, revisão e materiais por IA ficam disponíveis para usuários com plano ativo.")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AppSetting {
  id                String   @id @default("default")
  appName           String   @default("Gerador de Questões")
  logoUrl           String   @default("/brand/logo.png")
  faviconUrl        String   @default("/brand/favicon.png")
  primaryColor      String   @default("#13666a")
  accentColor       String   @default("#f6d979")
  publicUrl         String?
  adminEmails       String   @default("")
  institutionalText String   @default("Plataforma AI-first para gerar questões, simulados, revisões e materiais de estudo para concursos públicos.")
  termsUrl          String?
  privacyUrl        String?
  termsContent      String?
  privacyContent    String?
  // Identificação legal usada nos Termos e na Política de Privacidade. Campo vazio OMITE a
  // frase/seção correspondente no texto — nunca publicar placeholder entre colchetes.
  legalEntityName   String?
  legalEntityCnpj   String?
  supportEmail      String?
  dpoName           String?
  dpoEmail          String?
  legalVenueCity    String?
  trialGenerationsLimit Int  @default(10)
  // Banco público de questões: respostas/dia para quem está no trial (sem assinatura).
  bankDailyAnswersLimitTrial Int @default(10)
  // Teto de questões POR bloco gerado para quem está no trial. A cota mensal acima limita
  // quantas vezes ele gera; este campo limita o tamanho de cada geração — sem ele, o visitante
  // pedia 20 questões e consumia o custo de um assinante em uma única mensagem grátis.
  // 0 = sem teto (o trial gera blocos do mesmo tamanho que um assinante).
  trialMaxQuestionsPerGeneration Int @default(5)
  // Mesmo formato de SubscriptionPlan.capabilities, aplicado a quem não tem assinatura.
  // É aqui que se decide o que a conta gratuita enxerga do produto.
  trialCapabilities Json @default("{}")
  // Cota de QUESTÕES do trial. Complementa trialGenerationsLimit, que segue medindo as
  // ações de IA (mensagens de chat e materiais) e continua sendo a chave-mestra: em 0, o
  // trial inteiro fica desligado e o app volta a exigir assinatura.
  trialQuestionsPerMonth Int @default(30)
  /**
   * Modo sombra do medidor novo. Em `false` (padrão), o livro-caixa grava e os painéis
   * mostram, mas quem BLOQUEIA continua sendo o limite antigo — dá para observar o consumo
   * real por semanas antes de arriscar cortar um cliente pagante por um número mal calibrado.
   * Vire para `true` só depois de conferir os números em produção.
   */
  usageEnforcementEnabled Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum MercadoPagoCheckoutMode {
  CHECKOUT_PRO
  TRANSPARENT
}

model PaymentGatewaySetting {
  id                          String          @id @default("default")
  stripeSecretKey             String?
  stripeWebhookSecret         String?
  stripePortalEnabled         Boolean         @default(true)
  mercadoPagoAccessToken      String?
  mercadoPagoWebhookSecret    String?
  mercadoPagoPublicKey        String?
  mercadoPagoCheckoutMode     MercadoPagoCheckoutMode @default(CHECKOUT_PRO)
  testMode                    Boolean         @default(true)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
}

model EmailSetting {
  id        String        @id @default("default")
  provider  EmailProvider @default(BREVO)
  apiKey    String?
  fromEmail String?
  fromName  String?
  replyTo   String?
  enabled   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ContactMessageKind {
  GENERAL
  TEAMS
}

model ContactMessage {
  id        String             @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  kind      ContactMessageKind @default(GENERAL)
  userId    String?
  handledAt DateTime?
  createdAt DateTime           @default(now())

  @@index([kind])
  @@index([handledAt])
}

enum TeamAccountStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum TeamSeatStatus {
  PENDING
  CLAIMED
  REVOKED
}

model TeamAccount {
  id                 String            @id @default(cuid())
  name               String
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  cpfCnpj            String?
  planId             String
  seats              Int               @default(1)
  priceCents         Int               @default(0)
  status             TeamAccountStatus @default(ACTIVE)
  currentPeriodEndsAt DateTime?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  members   TeamSeat[]
  charges   TeamCharge[]
  mockExams MockExam[]
}

model TeamSeat {
  id            String         @id @default(cuid())
  teamAccountId String
  cpf           String?
  inviteCode    String?        @unique
  userId        String?
  claimedAt     DateTime?
  status        TeamSeatStatus @default(PENDING)
  createdAt     DateTime       @default(now())

  teamAccount TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Cascade)

  @@index([teamAccountId])
  @@index([cpf])
  @@index([userId])
}

model TeamCharge {
  id              String                   @id @default(cuid())
  teamAccountId   String
  amountCents     Int
  status          PaymentTransactionStatus @default(PENDING)
  externalId      String?
  pixQrCode       String?
  pixQrCodeBase64 String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  teamAccount TeamAccount @relation(fields: [teamAccountId], references: [id], onDelete: Cascade)

  @@index([teamAccountId])
}

enum FeedbackType {
  GABARITO_ERRADO
  ENUNCIADO_CONFUSO
  DESATUALIZADA
  OUTRO
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model QuestionFeedback {
  id         String         @id @default(cuid())
  userId     String
  questionId String
  type       FeedbackType   @default(OUTRO)
  message    String?
  status     FeedbackStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([status])
  @@index([questionId])
}

enum ReferenceKind {
  PROVA
  GABARITO
  EDITAL
  LEI
  RESUMO
  OUTRO
}

enum ReferenceExtractionStatus {
  PENDING
  PROCESSING
  DONE
  ERROR
}

model ReferenceDocument {
  id               String                    @id @default(cuid())
  title            String
  source           String?
  kind             ReferenceKind             @default(OUTRO)
  subjectId        String?
  topicId          String?
  createdById      String?
  extractionStatus ReferenceExtractionStatus @default(PENDING)
  extractionCursor Int                       @default(0)
  extractionError  String?
  createdAt        DateTime                  @default(now())
  chunks           ReferenceChunk[]
  questions        ReferenceQuestion[]
}

model ReferenceQuestion {
  id               String            @id @default(cuid())
  documentId       String
  subjectId        String?
  topicId          String?
  statement        String
  // Texto de apoio compartilhado (texto de leitura, situação hipotética) do qual esta questão
  // depende — separado do statement (que fica só com o comando/julgamento específico do item),
  // pra permitir agrupar no admin as questões que compartilham o mesmo texto ("bloco").
  supportText      String?
  answer           QuestionAnswer?
  answerText       String?
  explanation      String?
  trickNote        String?
  hasImage         Boolean           @default(false)
  imageDescription String?
  topicHint        String?
  // Sugestões da IA pra reorganização futura em categorias reais — não vinculadas a
  // Subject/Topic ainda, só texto livre pra um admin revisar e mapear depois.
  subjectHint      String?
  regionHint       String?
  ordinal          Int
  createdAt        DateTime          @default(now())
  document         ReferenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generatedQuestions Question[]

  @@index([documentId])
  @@index([subjectId])
  @@index([topicId])
}

model ReferenceChunk {
  id         String            @id @default(cuid())
  documentId String
  subjectId  String?
  topicId    String?
  content    String
  ordinal    Int
  createdAt  DateTime          @default(now())
  document   ReferenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([subjectId])
  @@index([topicId])
}

model PaymentCheckoutSession {
  id                 String                @id @default(cuid())
  userId             String
  planId             String
  provider           PaymentProvider
  status             PaymentCheckoutStatus @default(PENDING)
  externalId         String?
  checkoutUrl        String?
  amountCents        Int
  currency           String                @default("BRL")
  metadata           Json?
  expiresAt          DateTime?
  couponId           String?
  // Quanto o cupom abateu nesta tentativa específica (o valor do cupom pode mudar depois).
  discountCents      Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  coupon             Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  transactions       PaymentTransaction[]

  @@index([provider, externalId])
}

model PaymentTransaction {
  id                String                   @id @default(cuid())
  userId            String
  planId            String
  checkoutSessionId String?
  provider          PaymentProvider
  status            PaymentTransactionStatus @default(PENDING)
  externalId        String?
  amountCents       Int
  currency          String                   @default("BRL")
  paidAt            DateTime?
  // Entra ou não no total de "Receita registrada" do painel. Nasce false em transações
  // MANUAL (cortesia, assinatura liberada pelo admin, teste) porque não houve dinheiro
  // entrando; o admin também pode virar a chave à mão em Admin → Pagamentos para tirar do
  // caixa uma cobrança de teste ou estornada fora do gateway.
  countsAsRevenue   Boolean                  @default(true)
  rawPayload        Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  checkoutSession   PaymentCheckoutSession?  @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  affiliateCommission AffiliateCommission?

  @@unique([provider, externalId])
}

// ── Programa de afiliados ─────────────────────────────────────────────────
// Contas selecionadas a dedo pelo admin ganham um link (/r/<code>); quem se
// cadastra por ele fica atribuído ao afiliado (cookie de 30 dias) e cada
// pagamento aprovado gera comissão pelo % vigente. Saques via Pix, aprovados
// manualmente pelo admin.

enum AffiliateWithdrawalStatus {
  REQUESTED
  PAID
  REJECTED
}

model AffiliateProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  code              String   @unique
  commissionPercent Int      @default(20)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]
  withdrawals AffiliateWithdrawal[]
}

model AffiliateReferral {
  id             String   @id @default(cuid())
  affiliateId    String
  referredUserId String   @unique
  createdAt      DateTime @default(now())
  affiliate    AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser User             @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
}

model AffiliateCommission {
  id                   String   @id @default(cuid())
  affiliateId          String
  referredUserId       String
  paymentTransactionId String   @unique
  baseAmountCents      Int
  percent              Int
  amountCents          Int
  createdAt            DateTime @default(now())
  affiliate          AffiliateProfile   @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
}

model AffiliateWithdrawal {
  id          String                    @id @default(cuid())
  affiliateId String
  amountCents Int
  pixKey      String
  status      AffiliateWithdrawalStatus @default(REQUESTED)
  note        String?
  createdAt   DateTime                  @default(now())
  processedAt DateTime?
  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@index([status])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  userId         String
  subscriptionId String?
  provider       PaymentProvider
  type           SubscriptionEventType
  externalId     String?
  payload        Json?
  createdAt      DateTime              @default(now())
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   UserSubscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}
