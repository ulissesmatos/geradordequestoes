# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/perguntas_concursos"

# Authentication (NextAuth v5)
AUTH_SECRET="gere-um-segredo-forte-com-openssl-rand-hex-32"
AUTH_URL="http://localhost:3000"

# Login com Google (OAuth). Crie credenciais em:
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# (ex.: http://localhost:3000/api/auth/callback/google e a URL de produção)
# AUTH_GOOGLE_ID="xxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="GOCSPX-xxx"

# Admin credentials (change these for production!)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="senha-forte-troque-antes-de-produzir"

# Encryption (AES-256-GCM for API keys and payment secrets at rest)
# Generate: openssl rand -base64 32
# WITHOUT this, keys are stored plaintext (functional but not recommended for prod)
ENCRYPTION_KEY="gere-uma-chave-de-32-bytes-com-openssl-rand-base64-32"

# Optional: Fallback OpenAI API key (if no key configured in admin panel)
# RECOMMENDED: configure via Admin > Configuração de IA instead
# OPENAI_API_KEY="sua-chave-openai-opcional"

# Optional: Vercel Blob storage for chat attachments (images/PDF)
# Required for: drag-drop images, PDF uploads in chat
# Generate: Vercel dashboard > Storage > Blob > Create > Copy token
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"
